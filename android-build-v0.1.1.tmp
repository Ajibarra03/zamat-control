plugins {
    id 'com.android.application'
}

android {
    namespace 'com.zamat.control'
    compileSdk 35

    defaultConfig {
        applicationId 'com.zamat.control'
        minSdk 23
        targetSdk 35
        versionCode 2
        versionName '0.1.1'
    }

    buildTypes {
        release {
            minifyEnabled false
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }
}
